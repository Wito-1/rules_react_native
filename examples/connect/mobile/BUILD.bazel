load("@npm//:defs.bzl", "npm_link_all_packages")
load(
    "@rules_react_native//react_native:defs.bzl",
    "react_native_android_app",
    "react_native_apk_test",
    "react_native_bundle",
)

npm_link_all_packages(name = "node_modules")

react_native_bundle(
    name = "bundle_android",
    srcs = [
        "App.tsx",
        "app.json",
        "babel.config.js",
        "index.js",
        "package.json",
        "polyfills.js",
    ],
    node_modules = ":node_modules",
    platform = "android",
)

react_native_android_app(
    name = "greeter_mobile",
    srcs = [
        "android/java/com/example/mobile/MainActivity.java",
        "android/java/com/example/mobile/MainApplication.java",
    ],
    # The development server on the host, reached as localhost:8080.
    adb_reverse = [8080],
    bundle = ":bundle_android",
    manifest = "android/AndroidManifest.xml",
    # Plain HTTP to the development server.
    manifest_placeholders = {"usesCleartextTraffic": "true"},
    package = "com.example.mobile",
    res = [
        "android/res/drawable/rn_edit_text_material.xml",
        "android/res/values/strings.xml",
        "android/res/values/styles.xml",
    ],
)

react_native_apk_test(
    name = "greeter_mobile_apk_test",
    apk = ":greeter_mobile",
    assets = ["index.android.bundle"],
    package = "com.example.mobile",
)
