load("@aspect_rules_js//js:defs.bzl", "js_run_devserver")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//connect/web:vite/package_json.bzl", vite_bin = "bin")

npm_link_all_packages(name = "node_modules")

_SRCS = [
    "index.html",
    "package.json",
    "src/App.jsx",
    "src/main.jsx",
    "vite.config.mjs",
    ":node_modules",
]

# bazel build //connect/web:dist
vite_bin.vite(
    name = "dist",
    srcs = _SRCS,
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

vite_bin.vite_binary(name = "vite")

# ibazel run //connect/web:dev   (http://localhost:5173)
js_run_devserver(
    name = "dev",
    args = ["--port=5173"],
    chdir = package_name(),
    data = _SRCS,
    tool = ":vite",
)
