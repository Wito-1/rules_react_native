"""React Native libraries from npm, generated by `bazel run //third_party:autolink`. Do not edit.

Re-run it after adding, removing or upgrading a native npm dependency; the generated
`//third_party:autolink_test` fails while this file is stale.
"""

load("@rules_react_native//react_native:defs.bzl", "react_native_codegen", "react_native_npm_library")

def react_native_libraries(node_modules = ":node_modules", maven = "@rn_maven", **kwargs):
    """Declares one react_native_npm_library per native dependency; returns their labels for the app's deps."""
    react_native_codegen(
        name = "npm_react_native_safe_area_context_codegen",
        java_package = "com.th3rdwave.safeareacontext",
        js_srcs_dir = "src/specs",
        library_name = "safeareacontext",
        node_modules = node_modules,
        npm_package = "react-native-safe-area-context",
        **kwargs
    )
    react_native_npm_library(
        name = "npm_react_native_safe_area_context",
        build_config = True,
        cc_includes = [
            "android/src/main/jni",
            "common/cpp",
        ],
        cc_srcs = [
            "common/cpp/react/renderer/components/safeareacontext/RNCSafeAreaViewShadowNode.cpp",
            "common/cpp/react/renderer/components/safeareacontext/RNCSafeAreaViewState.cpp",
        ],
        codegen = [":npm_react_native_safe_area_context_codegen"],
        codegen_cc_dirs = [
            ".",
            "react/renderer/components/safeareacontext",
        ],
        component_descriptors = [
            "RNCSafeAreaProviderComponentDescriptor",
            "RNCSafeAreaViewComponentDescriptor",
        ],
        java_dirs = [
            "android/src/main/java",
            "android/src/fabric/java",
        ],
        manifest = "android/src/main/AndroidManifest.xml",
        npm_package = node_modules + "/react-native-safe-area-context",
        package = "com.th3rdwave.safeareacontext",
        react_packages = [
            "com.th3rdwave.safeareacontext.SafeAreaContextPackage",
        ],
        **kwargs
    )
    return [
        ":npm_react_native_safe_area_context",
    ]
