load("@npm//:defs.bzl", "npm_link_all_packages")
load(":react_native_libraries.bzl", "react_native_libraries")
load(
    "@rules_react_native//react_native:defs.bzl",
    "react_native_android_app",
    "react_native_apk_test",
    "react_native_autolink",
    "react_native_bundle",
)

npm_link_all_packages(name = "node_modules")

# `bazel run :autolink` regenerates react_native_libraries.bzl from package.json's native deps:
# react-native-safe-area-context, which is Kotlin with codegen'd specs and a hand-written C++
# shadow node.
react_native_autolink(
    name = "autolink",
    node_modules = ":node_modules",
)

react_native_bundle(
    name = "bundle_android",
    srcs = [
        "App.tsx",
        "app.json",
        "babel.config.js",
        "index.js",
        "package.json",
    ],
    node_modules = ":node_modules",
    platform = "android",
)

react_native_android_app(
    name = "third_party",
    minify = True,
    srcs = [
        "android/java/com/example/thirdparty/MainActivity.kt",
        "android/java/com/example/thirdparty/MainApplication.kt",
    ],
    bundle = ":bundle_android",
    # Content draws under the status bar, so the insets the library reports are non-zero.
    edge_to_edge = True,
    manifest = "android/AndroidManifest.xml",
    package = "com.example.thirdparty",
    res = [
        "android/res/drawable/rn_edit_text_material.xml",
        "android/res/values/strings.xml",
        "android/res/values/styles.xml",
    ],
    deps = react_native_libraries(),
)

react_native_apk_test(
    name = "third_party_apk_test",
    aab = True,
    apk = ":third_party",
    assets = ["index.android.bundle"],
    package = "com.example.thirdparty",
)
