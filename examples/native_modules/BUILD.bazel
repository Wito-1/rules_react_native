load("@npm//:defs.bzl", "npm_link_all_packages")
load(
    "@rules_react_native//react_native:defs.bzl",
    "react_native_android_app",
    "react_native_apk_test",
    "react_native_bundle",
    "react_native_codegen",
    "react_native_dev_server",
)

npm_link_all_packages(name = "node_modules")

_JS_SRCS = [
    "App.tsx",
    "app.json",
    "babel.config.js",
    "index.js",
    "package.json",
    "specs/GreetingViewNativeComponent.ts",
    "specs/NativeLocalStorage.ts",
]

_JAVA_SRCS = [
    "android/java/com/example/nativemodules/MainActivity.java",
    "android/java/com/example/nativemodules/MainApplication.java",
]

_RES = [
    "android/res/drawable/rn_edit_text_material.xml",
    "android/res/values/strings.xml",
    "android/res/values/styles.xml",
]

# Java/C++ glue for the specs; compiled by //native_modules/greeting, which implements them.
react_native_codegen(
    name = "codegen",
    srcs = [
        "package.json",
        "specs/GreetingViewNativeComponent.ts",
        "specs/NativeLocalStorage.ts",
    ],
    java_package = "com.example.greeting.specs",
    js_srcs_dir = "specs",
    library_name = "AppSpecs",
    node_modules = ":node_modules",
    visibility = ["//native_modules/greeting:__pkg__"],
)

react_native_bundle(
    name = "bundle_android",
    srcs = _JS_SRCS,
    node_modules = ":node_modules",
    platform = "android",
)

react_native_android_app(
    name = "native_modules",
    minify = True,
    srcs = _JAVA_SRCS,
    bundle = ":bundle_android",
    manifest = "android/AndroidManifest.xml",
    package = "com.example.nativemodules",
    res = _RES,
    deps = ["//native_modules/greeting"],
)

react_native_android_app(
    name = "native_modules_debug",
    srcs = _JAVA_SRCS,
    debug = True,
    manifest = "android/AndroidManifest.xml",
    package = "com.example.nativemodules",
    res = _RES,
    deps = ["//native_modules/greeting"],
)

react_native_dev_server(
    name = "start",
    srcs = _JS_SRCS,
    node_modules = ":node_modules",
)

react_native_apk_test(
    name = "native_modules_apk_test",
    aab = True,
    apk = ":native_modules",
    assets = [
        "index.android.bundle",
        "greeting.txt",
    ],
    package = "com.example.nativemodules",
)

react_native_apk_test(
    name = "native_modules_debug_apk_test",
    apk = ":native_modules_debug",
    assets = ["greeting.txt"],
    package = "com.example.nativemodules",
)
