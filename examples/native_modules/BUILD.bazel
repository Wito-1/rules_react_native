load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_react_native//react_native:defs.bzl", "react_native_android_app", "react_native_bundle", "react_native_codegen", "react_native_dev_server")

npm_link_all_packages(name = "node_modules")

_JS_SRCS = [
    "App.tsx",
    "app.json",
    "babel.config.js",
    "index.js",
    "package.json",
    "specs/GreetingViewNativeComponent.ts",
    "specs/NativeLocalStorage.ts",
]

_JAVA_SRCS = [
    "android/java/com/example/nativemodules/AppSpecsPackage.java",
    "android/java/com/example/nativemodules/GreetingViewManager.java",
    "android/java/com/example/nativemodules/MainActivity.java",
    "android/java/com/example/nativemodules/MainApplication.java",
    "android/java/com/example/nativemodules/NativeLocalStorageModule.java",
]

_RES = [
    "android/res/drawable/rn_edit_text_material.xml",
    "android/res/values/strings.xml",
    "android/res/values/styles.xml",
]

react_native_codegen(
    name = "codegen",
    srcs = [
        "package.json",
        "specs/GreetingViewNativeComponent.ts",
        "specs/NativeLocalStorage.ts",
    ],
    java_package = "com.example.nativemodules.specs",
    js_srcs_dir = "specs",
    library_name = "AppSpecs",
    node_modules = ":node_modules",
)

react_native_bundle(
    name = "bundle_android",
    srcs = _JS_SRCS,
    node_modules = ":node_modules",
    platform = "android",
)

react_native_android_app(
    name = "native_modules",
    srcs = _JAVA_SRCS,
    bundle = ":bundle_android",
    codegen = [":codegen"],
    manifest = "android/AndroidManifest.xml",
    package = "com.example.nativemodules",
    react_packages = ["com.example.nativemodules.AppSpecsPackage"],
    res = _RES,
)

react_native_android_app(
    name = "native_modules_debug",
    srcs = _JAVA_SRCS,
    codegen = [":codegen"],
    debug = True,
    manifest = "android/AndroidManifest.xml",
    package = "com.example.nativemodules",
    react_packages = ["com.example.nativemodules.AppSpecsPackage"],
    res = _RES,
)

react_native_dev_server(
    name = "start",
    srcs = _JS_SRCS,
    node_modules = ":node_modules",
)
