load("@npm//:defs.bzl", "npm_link_all_packages")
load(":react_native_libraries.bzl", "react_native_libraries")
load(
    "@rules_react_native//react_native:defs.bzl",
    "react_native_android_app",
    "react_native_apk_test",
    "react_native_autolink",
    "react_native_bundle",
)

npm_link_all_packages(name = "node_modules")

react_native_autolink(
    name = "autolink",
    node_modules = ":node_modules",
)

react_native_bundle(
    name = "bundle_android",
    srcs = [
        "App.tsx",
        "app.json",
        "babel.config.js",
        "index.js",
        "metro.config.js",
        "package.json",
    ],
    node_modules = ":node_modules",
    platform = "android",
)

react_native_android_app(
    name = "expo",
    srcs = [
        "android/java/com/example/expo/MainActivity.kt",
        "android/java/com/example/expo/MainApplication.kt",
    ],
    bundle = ":bundle_android",
    manifest = "android/AndroidManifest.xml",
    package = "com.example.expo",
    res = [
        "android/res/drawable/rn_edit_text_material.xml",
        "android/res/values/strings.xml",
        "android/res/values/styles.xml",
    ],
    deps = react_native_libraries(),
)

react_native_apk_test(
    name = "expo_apk_test",
    apk = ":expo",
    assets = ["index.android.bundle"],
    classes = [
        "expo.modules.ExpoModulesPackageList",
        "expo.modules.ExpoModulesV2ModuleList",
        "expo.modules.statusbar.StatusBarPackage",
    ],
    native_libs = [
        "libappmodules.so",
        "libc++_shared.so",
        "libexpo-modules-core.so",
        "libexpo-modules-jsi.so",
        "libhermesvm.so",
        "libreactnative.so",
    ],
    package = "com.example.expo",
)
